# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/

# Node
frontend/node_modules/
frontend/dist/

# Model caches and weights — these are huge and should never be committed
**/models/*
!backend/models/README.md
*.bin
*.safetensors
.cache/
huggingface_cache/

# Environment/secrets
.env
*.env.local

# Generated data (keep folder structure, ignore contents)
demo_images/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
data/MODI_HChar/
# Database
*.db
*.sqlite
*.sqlite3

# Local experiment scratch (regenerable by re-running the sweep)
experiments/results/_replay_index.json
# Colab working files
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Working docs stay local — only the public README ships in the repo
*.md
!README.md

# Office lock files (auto-created when a doc is open, auto-deleted on close)
~$*
